---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL('img/cat.png', Astro.site).href;
const payload = JSON.stringify({
  component: {
    type: 17,
    accent_color: 0x5865f2,
    components: [
      {
        type: 9,
        components: [
          {
            type: 10,
            content: `## [${title}](${url})\n${description}`
          },
        ],
        accessory: {
          type: 11,
          media: { url: image },
          description: 'littlecommandcat',
        },
      },
      {
        type: 14,
        divider: true,
        spacing: 1,
      },
      {
        type: 1,
        components: [
          {
            type: 2,
            style: 5,
            label: 'GitHub',
            url: 'https://github.com/littlecommandcat',
            emoji: {
              id: "1557691048786927646",
              animated: false
            }
          },
          {
            type: 2,
            style: 5,
            label: '喵窩社群',
            url: 'https://dc.cmdcat.com',
            emoji: {
              id: "1434018280129171506",
              animated: true
            }
          },
          {
            type: 2,
            style: 5,
            label: '小喵喵',
            url: 'https://discord.com/oauth2/authorize?client_id=1144161789832069141',
            emoji: {
              id: "1474638849501298771",
              animated: false
            }
          },
        ],
      },
    ],
  },
}).replace(/</g, '\\u003c');

if (new TextEncoder().encode(payload).byteLength > 3000) {
  throw new Error('Discord component embed exceeds the 3,000-byte limit.');
}
---

<meta property="og:type" content="website" />
<meta property="og:site_name" content="littlecommandcat" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="littlecommandcat" />
<meta name="theme-color" content="#5865f2" />
<script is:inline id="discord:component-embed" type="application/json" set:html={payload} />