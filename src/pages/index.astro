---
import "../styles/global.css";
import "../styles/friends.css";
import "../styles/timeline.css";
import DiscordPreview from "../components/DiscordPreview.astro";
import { friendSites } from "../lib/friends";
import { getSortedTimeline } from "../lib/timeline";

const timeline = getSortedTimeline();
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <link
      rel="icon"
      type="image/ico"
      href={`${import.meta.env.BASE_URL}favicon.ico`}
    />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="littlecommandcat About"
    />
    <meta name="generator" content={Astro.generator} />
    <title>About — littlecommandcat</title>
    <DiscordPreview
      title="About"
      description="就是一隻貓 關於我的個人資料！"
    />
  </head>
  <body>
    <main>
      <header>
        <img
          src={`${import.meta.env.BASE_URL}img/cat.png`}
          alt="littlecommandcat"
          width="88"
          height="88"
        />
        <p class="eyebrow">LITTLECOMMANDCAT</p>
        <h1>關於我</h1>
        <p class="intro">關於我的個人資料</p>
        <a href="#timeline-heading">歷程</a>
        <a href="#friends-heading">友站</a>
        <a href="/github">作品集</a>
        <br>
        <a
          href="https://bot.cmdcat.com"
          rel="noopener noreferrer"
          target="_blank"
          >喵喵官網 ↗<span class="sr-only">（在新分頁開啟）</span></a
        >
      </header>
      <section aria-labelledby="timeline-heading">
        <h2 id="timeline-heading">歷程</h2>
        {timeline.length > 0 ? (
          <ol class="timeline" aria-label="歷程">
            {timeline.map(entry => (
              <li>
                <time datetime={entry.date}>{entry.date.replaceAll('-', ' / ')}</time>
                <h3>{entry.title}</h3>
                {entry.description && <p>{entry.description}</p>}
              </li>
            ))}
          </ol>
        ) : (
          <p class="timeline-empty">暫無歷程</p>
        )}
        <p class="timeline-end">持續向前...</p>
      </section>
      <section aria-labelledby="friends-heading">
        <h2 id="friends-heading">友站</h2>
        {friendSites.length > 0 ? (
          <ul class="friend-sites" aria-label="友站列表">
            {friendSites.map(site => (
              <li>
                <img
                  class="friend-avatar"
                  src={site.avatar_url}
                  alt={site.name}
                  width="88"
                  height="88"
                />
                <h3>
                  <a href={site.url} target="_blank" rel="noopener noreferrer">
                    {site.name} ↗
                    <span class="sr-only">（在新分頁開啟）</span>
                  </a>
                </h3>
                {site.description && <p>{site.description}</p>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="friends-empty">暫無友站</p>
        )}
      </section>
      <footer id="copyright">
        © 2026 littlecommandcat<a href="mailto:support@cmdcat.com" style="margin-left: 16px;">support@cmdcat.com</a>
      </footer>
    </main>
  </body>
</html>
